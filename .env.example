# ==============================================================================
# CHOOMCHAM HOUSE — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# B2B Transformation Platform Stack: Remix + Supabase + Cloudflare + LINE OA + Resend + AI
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. 🌐 APP & DOMAIN CONFIGURATION
# ------------------------------------------------------------------------------
APP_URL=https://choomcham.pages.dev
VITE_APP_URL=https://choomcham.pages.dev
ADMIN_SECRET_KEY=your_secure_admin_jwt_secret

# ------------------------------------------------------------------------------
# 2. 🗄️ SUPABASE (DATABASE, AUTH & RLS)
# ------------------------------------------------------------------------------
# รับค่าได้จาก Supabase Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service Role Key (ใช้เฉพาะบน Cloudflare Workers / Server Edge Proxy ห้ามเปิดเผยใน Client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Server-only allowlist for the course designer. Users must exist in Supabase Auth.
# Empty/missing list denies all team workspace API access.
COURSE_ADMIN_EMAILS=

# ------------------------------------------------------------------------------
# 3. 💬 LINE OA MESSAGING API (FLEX MESSAGE & CRM NOTIFICATIONS)
# ------------------------------------------------------------------------------
# รับค่าจาก LINE Developers Console (Messaging API Channel)
LINE_CHANNEL_ACCESS_TOKEN=your_channel_access_token_long_lived
LINE_CHANNEL_SECRET=your_channel_secret_key
# LINE User ID หรือ Group ID ของผู้บริหาร/แอดมิน ที่ต้องการให้ Push แจ้งเตือน Lead เข้าไป
LINE_TARGET_USER_ID=U1234567890abcdef1234567890abcdef
# LINE Notify Token (Fallback สำหรับ Group Alert ทั่วไป)
LINE_NOTIFY_TOKEN=your_line_notify_token

# ------------------------------------------------------------------------------
# 4. 📧 RESEND EMAIL SERVICE (NOTIFICATIONS & AUTO REBIRTH PDF REPORTS)
# ------------------------------------------------------------------------------
# รับค่าจาก https://resend.com/api-keys
RESEND_API_KEY=re_123456789_abcdefg
NOTIFICATION_EMAIL=owner@choomcham.house
SENDER_EMAIL=noreply@choomcham.house

# ------------------------------------------------------------------------------
# 5. ☁️ CLOUDFLARE R2 STORAGE (ASSETS, PDF REPORTS, PROPOSALS)
# ------------------------------------------------------------------------------
CLOUDFLARE_ACCOUNT_ID=1af3cf042ce92dccf6c10ecb81c0181b
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=choomcham-assets
R2_PUBLIC_DOMAIN=https://assets.choomcham.house

# ------------------------------------------------------------------------------
# 6. 🤖 AI ENGINE (CHAT, PROPOSAL DESIGN & TRANSFORMATION CONSULTANT)
# ------------------------------------------------------------------------------
# สำหรับระบบ AI ออกแบบหลักสูตรเฉพาะองค์กร, ประเมินความต้องการ, และสร้างใบเสนอราคา
OPENAI_API_KEY=sk-proj-your_openai_api_key
GEMINI_API_KEY=AIzaSy_your_gemini_api_key
